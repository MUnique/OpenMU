# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.cpp text
*.h text
*.cs text
*.csproj text
*.sln text

# Packet docs are generated with LF line endings on every platform
# (see GenerateMarkdownDocs.xslt), so check them out with LF everywhere
# to avoid phantom diffs after a build.
docs/Packets/*.md text eol=lf