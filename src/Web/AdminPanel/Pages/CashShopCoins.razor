@page "/accounts/{LoginName}/cash-shop"
@attribute [Authorize(Policy = AdminPolicies.CashShop)]

@using MUnique.OpenMU.DataModel
@using MUnique.OpenMU.DataModel.Configuration
@using MUnique.OpenMU.DataModel.Entities
@using MUnique.OpenMU.Web.AdminPanel.Properties
@using MUnique.OpenMU.Web.AdminPanel.Services

@{
    var title = string.Format(Resources.CashShopCoinsOf, this.LoginName);
}
<PageTitle>OpenMU: @title</PageTitle>
<Breadcrumb Caption="@title" />
<h1>@title</h1>

<p class="text-muted">@Resources.CashShopCoinsDescription</p>

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else if (this._summary is not { } summary)
{
    <p>@Resources.CashShopCoinsAccountNotFound</p>
}
else
{
    <table class="table table-sm w-auto">
        <tbody>
        @foreach (var coinType in Enum.GetValues<CashShopCoinType>())
        {
            <tr>
                <th>@CashShopCoinCaption.Get(coinType)</th>
                <td class="text-end">@GetBalance(summary, coinType).ToString("N0")</td>
                <td class="text-muted">@this.GetPendingText(summary, coinType)</td>
            </tr>
        }
        </tbody>
    </table>

    <h2>@Resources.CashShopGrantCoins</h2>
    <EditForm Model="this._input" OnValidSubmit="this.OnGrantAsync" class="row g-2 align-items-end mb-4">
        <DataAnnotationsValidator />
        <div class="col-auto">
            <label class="form-label" for="coinType">@Resources.CashShopCoinType</label>
            <InputSelect id="coinType" class="form-select" @bind-Value="this._input.CoinType">
                @foreach (var coinType in Enum.GetValues<CashShopCoinType>())
                {
                    <option value="@coinType">@CashShopCoinCaption.Get(coinType)</option>
                }
            </InputSelect>
        </div>
        <div class="col-auto">
            <label class="form-label" for="amount">@Resources.CashShopAmount</label>
            <InputNumber id="amount" class="form-control" @bind-Value="this._input.Amount" />
        </div>
        <div class="col-12 col-md">
            <label class="form-label" for="reason">@Resources.Description</label>
            <InputText id="reason" class="form-control" @bind-Value="this._input.Reason" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary" disabled="@this._isGranting">@Resources.CashShopGrantCoins</button>
        </div>
        <ValidationSummary />
    </EditForm>

    <h2>@Resources.CashShopGrants</h2>
    <div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
        <tr>
            <th>@Resources.Timestamp</th>
            <th>@Resources.CashShopCoinType</th>
            <th class="text-end">@Resources.CashShopAmount</th>
            <th>@Resources.Description</th>
            <th>@Resources.CashShopGrantedBy</th>
            <th>@Resources.CashShopReference</th>
            <th>@Resources.CashShopAppliedAt</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var grant in summary.Grants)
        {
            <tr>
                <td>@grant.CreatedAt.ToLocalTime()</td>
                <td>@CashShopCoinCaption.Get(grant.CoinType)</td>
                <td class="text-end">@grant.Amount.ToString("N0")</td>
                <td>@grant.Reason</td>
                <td>@grant.GrantedBy</td>
                <td><code>@grant.Reference</code></td>
                <td>@(grant.AppliedAt?.ToLocalTime().ToString() ?? Resources.CashShopPending)</td>
            </tr>
        }
        @if (summary.Grants.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-muted">@Resources.CashShopNoGrants</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
