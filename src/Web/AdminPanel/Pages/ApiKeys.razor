@page "/api-keys"
@using MUnique.OpenMU.Persistence.AdminAuth
@using MUnique.OpenMU.Web.AdminPanel.Properties
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@{
    var title = Resources.ApiKeys;
}
<PageTitle>OpenMU: @title</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@title" />
<h1>@title</h1>

<p class="text-muted">@Resources.ApiKeysDescription</p>

@if (!string.IsNullOrEmpty(this._createdKey))
{
    <div class="alert alert-warning" role="alert">
        <h5 class="alert-heading">@Resources.ApiKeyShownOnce</h5>
        <p>@Resources.ApiKeyShownOnceDescription</p>
        <code class="user-select-all d-block p-2 bg-body-secondary rounded">@this._createdKey</code>
        <button type="button" class="btn btn-sm btn-secondary mt-2" @onclick="@(() => this._createdKey = null)">@Resources.Close</button>
    </div>
}

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else
{
    <div>
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th class="col-3">@Resources.ApiKeyName</th>
                <th class="col-2">@Resources.ApiKeyPrefix</th>
                <th class="col-2">@Resources.Role</th>
                <th class="col-2">@Resources.LastUsed</th>
                <th class="col-3">@Resources.Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var apiKey in this._apiKeys)
            {
                <tr class="@(apiKey.IsDisabled ? "opacity-50" : null)">
                    <td>@apiKey.Name</td>
                    <td><code>@apiKey.KeyPrefix…</code></td>
                    <td>
                        <select class="form-select form-select-sm" value="@apiKey.Roles"
                                @onchange="@(args => this.OnRoleChangedAsync(apiKey, args.Value?.ToString()))">
                            @foreach (var role in AdminRoles.All)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </td>
                    <td>@(apiKey.LastUsedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td>
                        @if (apiKey.IsDisabled)
                        {
                            <button type="button" class="btn btn-sm btn-success me-1" @onclick="@(() => this.OnSetDisabledAsync(apiKey, false))">@Resources.Enable</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-warning me-1" @onclick="@(() => this.OnSetDisabledAsync(apiKey, true))">@Resources.Disable</button>
                        }
                        <button type="button" class="btn btn-sm btn-danger" @onclick="@(() => this.OnDeleteAsync(apiKey))">@Resources.Delete</button>
                    </td>
                </tr>
            }
            @if (this._apiKeys.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted">@Resources.NoApiKeys</td>
                </tr>
            }
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-success" @onclick="@this.OnCreateNewAsync">@Resources.CreateApiKey</button>
    </div>
}
