@page "/guild/{GuildId:guid}"
@using MUnique.OpenMU.DataModel
@using MUnique.OpenMU.DataModel.Entities
@using MUnique.OpenMU.Web.Shared.Models;
@using Resources = MUnique.OpenMU.Web.AdminPanel.Properties.Resources

@if (this._guild is null && !this._isLoading)
{
    <PageTitle>OpenMU: @Resources.Guild</PageTitle>
    <Breadcrumb IsFirstFromRoot="false" Caption="@Resources.Guild" />
    <div class="alert alert-warning" role="alert">@Resources.GuildNotFound</div>
    <NavLink href="guilds" class="btn btn-secondary">&lt; @Resources.Back</NavLink>
}
else if (this._guild is { } guild)
{
    <PageTitle>OpenMU: @guild.Name</PageTitle>
    <Breadcrumb IsFirstFromRoot="false" Caption="@guild.Name" />
    <div class="d-flex flex-row align-items-center gap-3">
        <NavLink href="guilds" class="btn btn-secondary">&lt; @Resources.Back</NavLink>
        <GuildLogo Logo="@guild.Logo" Size="32" class="border rounded-1" />
        <h1 class="mb-0">@guild.Name</h1>
    </div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">@Resources.Score</dt>
        <dd class="col-sm-10">@guild.Score</dd>
        <dt class="col-sm-2">@Resources.Members</dt>
        <dd class="col-sm-10">@guild.MemberCount</dd>
        @if (!string.IsNullOrEmpty(guild.Notice))
        {
            <dt class="col-sm-2">@Resources.Notice</dt>
            <dd class="col-sm-10">@guild.Notice</dd>
        }
        <dt class="col-sm-2">@Resources.Alliance</dt>
        <dd class="col-sm-10">
            @if (guild.AllianceGuildId is { } allianceId)
            {
                <NavLink href="@($"alliance/{allianceId}")">@guild.AllianceName</NavLink>
            }
            else
            {
                <span>—</span>
            }
        </dd>
    </dl>

    <h2>@Resources.Members</h2>
    @if (this._isLoading)
    {
        <p><em>@Resources.Loading</em></p>
    }
    else if (this._members.Count == 0)
    {
        <p><em>—</em></p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>@Resources.Character</th>
                        <th>@Resources.Account</th>
                        <th>@Resources.CharacterClass</th>
                        <th>@Resources.Level</th>
                        <th>@Resources.MasterLevel</th>
                        <th>@Resources.Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in this._members)
                    {
                        <tr>
                            <td>
                                @if (member.AccountId is { } accountId)
                                {
                                    <NavLink href="@($"edit-account/{accountId}/{typeof(Character).FullName}/{member.CharacterId}")">@member.CharacterName</NavLink>
                                }
                                else
                                {
                                    @member.CharacterName
                                }
                            </td>
                            <td>@(member.AccountLoginName ?? "—")</td>
                            <td>@(member.CharacterClass ?? "—")</td>
                            <td>@member.Level</td>
                            <td>@member.MasterLevel</td>
                            <td>@member.Position.GetEnumCaption()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <PageTitle>OpenMU: @Resources.Guild</PageTitle>
    <p><em>@Resources.Loading</em></p>
}
