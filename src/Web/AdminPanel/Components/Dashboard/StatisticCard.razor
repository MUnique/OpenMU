<section class="card h-100">
    <div class="card-body d-flex flex-column gap-1">
        <div class="d-flex justify-content-between align-items-center text-body-secondary small fw-semibold text-uppercase">
            <h2 class="h6 mb-0 small fw-semibold">@this.Title</h2>
            <span class="oi @this.Icon text-primary" aria-hidden="true"></span>
        </div>
        <div class="statistic-value">@this.Value</div>
        @if (this.ChildContent is not null)
        {
            <div class="small text-body-secondary">@this.ChildContent</div>
        }
    </div>
</section>

@code {
    /// <summary>
    /// Gets or sets the title.
    /// </summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the CSS class of the open iconic icon, e.g. <c>oi-people</c>.
    /// </summary>
    [Parameter]
    public string Icon { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the value.
    /// </summary>
    [Parameter]
    public RenderFragment? Value { get; set; }

    /// <summary>
    /// Gets or sets the details, which are shown below the value.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
