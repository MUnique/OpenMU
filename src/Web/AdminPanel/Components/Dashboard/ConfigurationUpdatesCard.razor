@using MUnique.OpenMU.Persistence.Initialization.Updates
@using MUnique.OpenMU.Web.AdminPanel.Properties

<section class="card h-100">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h6 mb-0">@Resources.DashboardConfigurationUpdates</h2>
        <span class="badge rounded-pill text-bg-light border">@Resources.DashboardAdministratorsOnly</span>
    </div>
    <div class="card-body d-flex flex-column gap-3">
        @switch (this._availableUpdates)
        {
            case null when this._isLoading:
                <span class="text-body-secondary">@Resources.Loading</span>
                break;
            case null:
                <span class="text-body-secondary">@Resources.DashboardNotAvailable</span>
                break;
            case 0:
                <span>@Resources.DashboardNoUpdates</span>
                break;
            default:
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-3 fw-semibold">@this._availableUpdates</span>
                    <span class="text-body-secondary">@Resources.DashboardUpdatesAvailable</span>
                </div>
                <a class="btn btn-primary align-self-start" href="config-updates">@Resources.DashboardReviewUpdates</a>
                break;
        }
    </div>
</section>

@code {
    private int? _availableUpdates;

    private bool _isLoading = true;

    /// <summary>
    /// Gets or sets the update service.
    /// </summary>
    [Inject]
    public DataUpdateService UpdateService { get; set; } = null!;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync().ConfigureAwait(true);
        try
        {
            var updates = await this.UpdateService.DetermineAvailableUpdatesAsync().ConfigureAwait(true);
            this._availableUpdates = updates.Count;
        }
        catch
        {
            // E.g. when the database is not initialized yet.
            this._availableUpdates = null;
        }
        finally
        {
            this._isLoading = false;
        }
    }
}
