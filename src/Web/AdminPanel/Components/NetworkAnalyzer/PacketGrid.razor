@using Microsoft.AspNetCore.Components.QuickGrid
@using MUnique.OpenMU.Network.Analyzer
@using MUnique.OpenMU.Web.AdminPanel.Properties

@if (this.Packets.Count == 0)
{
    <p class="text-muted"><em>@Resources.NoPacketsCaptured</em></p>
}
else
{
    <div class="packet-grid overflow-auto">
        <QuickGrid Items="@this.Packets.AsQueryable()" Virtualize="@this.Virtualize" ItemSize="28" Theme="none"
                   Class="table table-sm table-striped table-hover">
            <TemplateColumn Title="@Resources.Timestamp" Class="text-nowrap">
                @context.Timestamp.ToString(@"hh\:mm\:ss\.fff")
            </TemplateColumn>
            <TemplateColumn Title="@Resources.Direction" Class="text-nowrap">
                @if (context.ToServer)
                {
                    <span class="badge text-bg-primary">C&rarr;S</span>
                }
                else
                {
                    <span class="badge text-bg-success">S&rarr;C</span>
                }
            </TemplateColumn>
            <PropertyColumn Title="@Resources.Size" Property="@(packet => packet.Size)" Class="text-nowrap"/>
            <TemplateColumn Title="@Resources.PacketCode" Class="text-nowrap">
                @context.DisplayCode.ToString("X2")
            </TemplateColumn>
            <TemplateColumn Title="@Resources.PacketMessage">
                <span role="button" @onclick="() => this.OnSelect.InvokeAsync(context)"
                      class="@(this.SelectedPacket == context ? "fw-bold" : string.Empty)">
                    @this.GetMessage(context)
                </span>
            </TemplateColumn>
        </QuickGrid>
    </div>
}
