@using MUnique.OpenMU.DataModel.Configuration
@using MUnique.OpenMU.DataModel.Entities
@using MUnique.OpenMU.Persistence

@inherits InputBase<ICollection<SkillEntry>>

<div class="card mb-3">
    <h5 class="card-header">
        <FieldLabel Text="@Label" ValueExpression="@this.ValueExpression" />
    </h5>
    <div class="card-body card-text">
        <table class="table table-striped table-hover">
            <tbody>
            @foreach (var entry in this.RegularSkills)
            {
                <tr>
                    <td>@(entry.Skill?.GetName() ?? Resources.UnknownSkill)</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-danger" @onclick="@(() => this.OnRemoveSkillClickAsync(entry))">
                            <span class="oi oi-trash" aria-hidden="true"></span> @Resources.Remove
                        </button>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2" class="border-bottom-0">
                        <button type="button" class="btn btn-primary" @onclick="@this.OnAddRegularSkillClickAsync">@Resources.AddSkill</button>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@if (this.MasterSkillTree.Count > 0)
{
    <div class="card mb-3">
        <h5 class="card-header master-skill-tree-header">
            <span>@Resources.MasterSkillTree</span>
            <span class="master-skill-spent-points">@string.Format(Resources.SpentMasterPoints, this.SpentMasterPoints)</span>
            <button type="button" class="btn btn-danger ms-auto"
                    disabled="@(!this.MasterSkillEntries.Any())"
                    @onclick="@this.OnResetMasterSkillsClickAsync">
                <span class="oi oi-reload" aria-hidden="true"></span> @Resources.ResetMasterSkillTree
            </button>
        </h5>
        <div class="card-body">
            <div class="master-skill-tree">
                @foreach (var column in this.MasterSkillTree)
                {
                    <div class="master-skill-root">
                        <div class="master-skill-root-header">@column.Root.Name</div>
                        @foreach (var row in column.Ranks)
                        {
                            <div class="master-skill-rank">
                                <div class="master-skill-rank-label">@row.Rank</div>
                                <div class="master-skill-rank-skills">
                                    @foreach (var skill in row.Skills)
                                    {
                                        var definition = skill.MasterDefinition!;
                                        var level = this.GetLevel(skill);
                                        var requiredNames = this.GetRequiredSkillNames(skill);
                                        <div class="master-skill-entry @this.GetEntryCssClass(skill, level)" title="@this.GetEntryTooltip(skill, level)">
                                            <div class="master-skill-name">@skill.GetName()</div>
                                            @if (!string.IsNullOrEmpty(requiredNames))
                                            {
                                                <div class="master-skill-requires">↑ @requiredNames</div>
                                            }
                                            <input @key="@((skill.Number, this._levelInputVersion))"
                                                   type="number"
                                                   class="form-control form-control-sm master-skill-level-input"
                                                   value="@level"
                                                   min="0"
                                                   max="@definition.MaximumLevel"
                                                   aria-label="@skill.GetName()"
                                                   @onchange="@(e => this.OnMasterSkillLevelChangedAsync(skill, e))" />
                                            <div class="master-skill-maximum">/ @definition.MaximumLevel</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
