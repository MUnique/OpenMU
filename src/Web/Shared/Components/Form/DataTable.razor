@using MUnique.OpenMU.Web.Shared.Services;

@typeparam TItem where TItem : class

@if (this.SearchHeader != null)
{
    <div class="data-table-search d-flex flex-wrap align-items-center gap-2 my-2">@SearchHeader</div>
}

<Pager CurrentPage="@this.Page" HasNextPage="@this._hasMoreEntries" Disabled="@this._isLoading" PageChanged="@this.GetPageIfIdleAsync" />

@if (this.SearchHeader != null)
{
    <div class="data-table-search d-flex flex-wrap align-items-center gap-2 my-2">@SearchHeader</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>@TableHeader</tr>
        @if (this.FilterHeader != null)
        {
            <tr>@FilterHeader</tr>
        }
    </thead>
    <tbody>
        @if (this._items != null)
        {
            @foreach (var item in this._items)
            {
                <tr>@ItemTemplate(item)</tr>
            }
        }
        else if (this._isLoading)
        {
            <tr>@Resources.Loading</tr>
        }
    </tbody>
    <tfoot>
        <tr>@TableFooter</tr>
    </tfoot>
</table>

<Pager CurrentPage="@this.Page" HasNextPage="@this._hasMoreEntries" Disabled="@this._isLoading" PageChanged="@this.GetPageIfIdleAsync" />

@code {
    private bool _hasMoreEntries;

    private bool _isLoading;

    private IReadOnlyList<TItem>? _items;

    /// <summary>
    /// Gets or sets the table header column elements.
    /// </summary>
    [Parameter]
    public RenderFragment TableHeader { get; set; } = null!;

    /// <summary>
    /// Gets or sets the search elements (usually <see cref="SearchInput"/>s).
    /// They are shown left-aligned in a separate line before the header row.
    /// </summary>
    [Parameter]
    public RenderFragment? SearchHeader { get; set; }

    /// <summary>
    /// Gets or sets the table filter header column elements.
    /// </summary>
    [Parameter]
    public RenderFragment? FilterHeader { get; set; } = null!;

    /// <summary>
    /// Gets or sets the item row template.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem> ItemTemplate { get; set; } = null!;

    /// <summary>
    /// Gets or sets the table footer template.
    /// </summary>
    [Parameter]
    public RenderFragment? TableFooter { get; set; }

    /// <summary>
    /// Gets or sets the data service.
    /// </summary>
    [Inject]
    public IDataService<TItem> DataService { get; set; } = null!;

    /// <summary>
    /// Gets or sets the current page.
    /// </summary>
    public int Page { get; set; } = 1;

    /// <summary>
    /// Gets or sets the page size.
    /// </summary>
    public int PageSize { get; set; } = 20;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await this.GetPageAsync(1);
        if (this.DataService is ISupportDataChangedNotification dataChangedNotification)
        {
            dataChangedNotification.DataChanged += async (_, __) => await this.RefreshAsync();
        }
    }

    private Task RefreshAsync()
    {
        return this.GetPageAsync(this.Page);
    }

    private Task GetPageIfIdleAsync(int page)
    {
        if (this._isLoading)
        {
            return Task.CompletedTask;
        }

        return this.GetPageAsync(page);
    }

    private async Task GetPageAsync(int page)
    {
        var restartFromFirstPage = false;
        this._isLoading = true;
        try
        {
            await this.InvokeAsync(this.StateHasChanged).ConfigureAwait(false);
            var loadedItems = await this.DataService.GetAsync((page - 1) * this.PageSize, this.PageSize);
            var isRefresh = this.Page == page;
            if (isRefresh)
            {
                // when refreshing, always set the items.
                this._items = loadedItems;
            }

            if (loadedItems.Any())
            {
                this._items = loadedItems;
                this._hasMoreEntries = this._items.Count == this.PageSize;
                this.Page = page;
            }
            else
            {
                this._hasMoreEntries = false;

                // A refresh of a page which does not exist anymore (for example after a filter reduced the results) would
                // show an empty table without a way to notice why. Start over from the first page instead.
                restartFromFirstPage = isRefresh && page > 1;
            }
        }
        finally
        {
            this._isLoading = false;
            await this.InvokeAsync(this.StateHasChanged).ConfigureAwait(false);
        }

        if (restartFromFirstPage)
        {
            await this.GetPageAsync(1);
        }
    }
}
