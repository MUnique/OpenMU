@typeparam T

<div class="auto-form-container">
    @if (ShowSearch)
    {
        <SearchInput Class="mb-3"
                     Value="@(this._currentSearchTerm ?? string.Empty)"
                     ValueChanged="@(value => this._currentSearchTerm = value)" />
    }

    <EditForm Model="@Model" OnValidSubmit="OnValidSubmit" class="auto-form">
        <DataAnnotationsValidator />
        <AutoFields HideCollections="@this.HideCollections" SearchTerm="@this._currentSearchTerm" />
        <ValidationSummary />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@this.IsProcessing">
                @if (this.IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                @if (!this.IsProcessing)
                {
                    <span class="oi oi-cloud-upload" aria-hidden="true"></span>
                }
                @Resources.Save
            </button>
            @if (this.OnReload != null)
            {
                <button type="button" class="btn btn-secondary" disabled="@this.IsProcessing" @onclick="this.OnReload.Value">
                    <span class="oi oi-reload" aria-hidden="true"></span> @Resources.Reload
                </button>
            }
            @if (this.OnCancel != null)
            {
                <button type="button" class="btn btn-secondary" @onclick="this.OnCancel.Value">@Resources.Cancel</button>
            }
        </div>
    </EditForm>
</div>
