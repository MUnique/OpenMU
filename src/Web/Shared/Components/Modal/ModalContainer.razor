@using MUnique.OpenMU.Web.Shared.Services
@inject ModalService ModalService
@implements IDisposable

@ChildContent

@{
    var modals = this.ModalService.Modals;
}
@for (var i = 0; i < modals.Count; i++)
{
    var state = modals[i];
    var sizeClass = state.Options?.Size switch
    {
        ModalSize.Small => "modal-sm",
        ModalSize.Large => "modal-lg",
        ModalSize.ExtraLarge => "modal-xl",
        _ => string.Empty,
    };

    // Each level gets its own backdrop above the modals below it, so only the top one can be used.
    // The key keeps the components of the lower modals (and their state) while another one is on top.
    var zIndex = BaseZIndex + (i * ZIndexStep);
    <div @key="@($"backdrop-{state.GetHashCode()}")" class="modal-backdrop fade show" style="z-index: @zIndex" @onclick="HandleBackdropClickAsync"></div>
    @* All levels capture the same reference; the last one, the modal on top, wins. *@
    <div @key="state" class="modal fade d-block show" style="z-index: @(zIndex + 5)" tabindex="-1" role="dialog" @ref="_topModalRef">
        @RenderDialog(state, sizeClass)
    </div>
}

@code {
    /// <summary>
    /// The z-index of the lowest backdrop, like Bootstrap's.
    /// </summary>
    private const int BaseZIndex = 1050;

    /// <summary>
    /// The z-index difference between two stacked modals.
    /// </summary>
    private const int ZIndexStep = 20;

    private ElementReference _topModalRef;
    private int _previousCount;

    /// <summary>
    /// Gets or sets the child content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        this.ModalService.StateChanged += this.OnStateChanged;
    }

    private void OnStateChanged()
    {
        this.InvokeAsync(this.StateHasChanged);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var count = this.ModalService.Modals.Count;
        if (count > this._previousCount)
        {
            await this._topModalRef.FocusAsync();
        }

        this._previousCount = count;
    }

    private RenderFragment RenderDialog(ModalService.ModalState state, string sizeClass) => __builder =>
    {
        <div class="modal-dialog @sizeClass" role="document">
            <div class="modal-content">
                @if (state.Options?.HideHeader != true)
                {
                    <div class="modal-header">
                        <h5 class="modal-title">@state.Title</h5>
                        @if (state.Options?.HideCloseButton != true)
                        {
                            <button type="button" class="btn-close" @onclick="@(() => state.Instance.CancelAsync())"></button>
                        }
                    </div>
                }
                <div class="modal-body">
                    <DynamicComponent Type="state.ComponentType" Parameters="@GetParameters(state)" />
                </div>
            </div>
        </div>
    };

    private static Dictionary<string, object?> GetParameters(ModalService.ModalState state)
    {
        var result = new Dictionary<string, object?>();
        if (state.Parameters is not null)
        {
            foreach (var kvp in state.Parameters)
            {
                result[kvp.Key] = kvp.Value;
            }
        }

        // Only supply the Modal instance to content components that actually declare
        // a matching parameter (e.g. ModalQuestion). Passing it to a component that
        // doesn't - like the plain ModalMessage - makes Blazor throw "does not have a
        // property matching the name 'Modal'". This keeps simple modals boilerplate-free.
        var modalProperty = state.ComponentType.GetProperty("Modal");
        if (modalProperty is not null && modalProperty.PropertyType.IsAssignableFrom(typeof(ModalInstance)))
        {
            result["Modal"] = state.Instance;
        }

        return result;
    }

    private Task HandleBackdropClickAsync()
    {
        // Only the top backdrop can be clicked, as it covers the ones below.
        if (this.ModalService.Current is { } top && top.Options?.DisableBackgroundCancel != true)
        {
            return top.Instance.CancelAsync();
        }

        return Task.CompletedTask;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        this.ModalService.StateChanged -= this.OnStateChanged;
    }
}
