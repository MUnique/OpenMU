@if (this.GuildId is { } guildId)
{
    <NavLink href="@AdminRoutes.Guild(guildId)">@(this.GuildName ?? this.EmptyText)</NavLink>
}
else
{
    @(this.GuildName ?? this.EmptyText)
}

@code {
    /// <summary>
    /// Gets or sets the persistent identifier of the guild. If <c>null</c>, the name is rendered as plain text.
    /// </summary>
    [Parameter]
    public Guid? GuildId { get; set; }

    /// <summary>
    /// Gets or sets the name of the guild.
    /// </summary>
    [Parameter]
    public string? GuildName { get; set; }

    /// <summary>
    /// Gets or sets the text which is rendered when no guild name is available.
    /// </summary>
    [Parameter]
    public string EmptyText { get; set; } = "—";
}
